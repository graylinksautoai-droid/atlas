# Copy to .env and fill in. Never commit a real .env.

# PostgreSQL connection string. UTC is assumed; timestamps are stored with time zone.
DATABASE_URL=postgres://atlas:change-me@127.0.0.1:5432/atlas
# Used only by the test suite. Point it at a disposable database.
TEST_DATABASE_URL=postgres://atlas:change-me@127.0.0.1:5432/atlas_test

PORT=8090
HOST=127.0.0.1
NODE_ENV=production

# Random 40+ character string. Rotating it invalidates every session.
SESSION_SECRET=replace-with-openssl-rand-base64-32
COOKIE_SECURE=0

# Compliance scheduler. Interval in milliseconds, 900000 is 15 minutes.
SCHEDULER_ENABLED=1
COMPLIANCE_INTERVAL_MS=900000
DUE_SOON_HOURS=72

# AI provider. Any OpenAI compatible chat completions endpoint works.
# Leave AI_PROVIDER=none to run deterministic checks only; the UI labels that state.
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=google/gemma-4-31b-it
AI_TIMEOUT_MS=25000
AI_MAX_INPUT_CHARS=18000

# Upload limits and endpoint rate limits.
UPLOAD_MAX_BYTES=262144
LOGIN_RATE_LIMIT=8
UPLOAD_RATE_LIMIT=12

# Password given to the three demo accounts when seeding. Change it, or leave
# unset to use the documented demo password.
SEED_PASSWORD=
